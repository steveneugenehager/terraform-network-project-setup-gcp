# Copy to terraform.tfvars (gitignored) and fill in.
billing_account           = "XXXXXX-XXXXXX-XXXXXX"
terraform_service_account = "terraform-super-admin@SEED_PROJECT_ID.iam.gserviceaccount.com"
state_bucket              = "SEED_PROJECT_ID-tfstate"
project_prefix            = "shv"

# Optional: defaults shown. Keys are folders-stage environment names;
# each needs a "<env>/infrastructure" subfolder.
# environments = {
#   lab = "lab"
#   dev = "dev"
# }
# host_subfolder = "infrastructure"

# Tag that keeps host projects network-only (no VMs). From terraform-org-level-policy-gcp:
#   terraform output host_project_tag_value
# host_project_tag_value = "tagValues/123456789012"
