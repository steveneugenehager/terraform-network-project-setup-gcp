# Copy to terraform.tfvars (gitignored) and fill in.
billing_account           = "XXXXXX-XXXXXX-XXXXXX"
terraform_service_account = "terraform-super-admin@SEED_PROJECT_ID.iam.gserviceaccount.com"
state_bucket              = "SEED_PROJECT_ID-tfstate"
project_prefix            = "shv"

# Optional: defaults shown. Keys are folders-stage environment names;
# each needs a "<env>/infrastructure" subfolder.
# environments = {
#   lab = "lab"
#   dev = "dev"
# }
# host_subfolder = "infrastructure"
